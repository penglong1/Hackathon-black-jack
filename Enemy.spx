var (
	isClone bool
	gridCol int
	gridRow int
	lastCol int
	lastRow int
	direction int
	straightSteps int
	convoyId int
	convoySlot int
	isLeader bool
)

func absInt(value int) int {
	if value < 0 {
		return -value
	}
	return value
}

func faceDirection() {
	if direction == 0 {
		turnTo Up
	} else if direction == 1 {
		turnTo Right
	} else if direction == 2 {
		turnTo Down
	} else {
		turnTo Left
	}
}

func chooseDirection() int {
	deltaCol := baseCol - gridCol
	deltaRow := baseRow - gridRow

	if deltaRow > 0 && absInt(deltaCol) <= 1 {
		return 2
	}
	if deltaCol >= 0 {
		return 1
	}
	return 3
}

func refreshLeader() {
	if convoyId == 0 {
		isLeader = convoySlot == convoy0LeaderSlot
	} else {
		isLeader = convoySlot == convoy1LeaderSlot
	}
}

func takeHit() {
	if !isClone || !gameRunning {
		return
	}
	if isLeader {
		convoyLeaderDown convoyId, convoySlot
	}
	enemyDestroyed
	die
}

func moveOne() {
	lastCol = gridCol
	lastRow = gridRow
	nextDirection := chooseDirection()
	if nextDirection == direction {
		straightSteps++
	} else {
		straightSteps = 1
	}
	direction = nextDirection
	faceDirection

	if direction == 0 {
		gridRow--
	} else if direction == 1 {
		gridCol++
	} else if direction == 2 {
		gridRow++
	} else {
		gridCol--
	}

	if !insideGrid(gridCol, gridRow) {
		gridCol = lastCol
		gridRow = lastRow
		direction = int(rand(0, 3))
		straightSteps = 2
		return
	}
	setXYpos gridToX(gridCol), gridToY(gridRow)
}

func shoot() {
	spawnEnemyShot gridCol, gridRow, direction
}

func inLaserLine() bool {
	if laserDirection == 0 {
		return gridCol == Player.gridCol && gridRow < Player.gridRow
	} else if laserDirection == 1 {
		return gridRow == Player.gridRow && gridCol > Player.gridCol
	} else if laserDirection == 2 {
		return gridCol == Player.gridCol && gridRow > Player.gridRow
	}
	return gridRow == Player.gridRow && gridCol < Player.gridCol
}

onStart => {
	hide
}

onCloned data => {
	isClone = true
	convoyId = enemySpawnConvoy
	convoySlot = enemySpawnSlot
	refreshLeader
	gridCol = enemySpawnCol
	gridRow = enemySpawnRow
	direction = 2
	straightSteps = 0
	faceDirection
	setXYpos gridToX(gridCol), gridToY(gridRow)
	show

	forever => {
		if gameRunning {
			moveOne
			if isLeader && rand(1, 100) <= 35 {
				shoot
			}
			wait 0.6
		} else {
			wait 0.2
		}
	}
}

onTouchStart ["Steel", "Crate", "Enemy"], sprite => {
	if isClone {
		gridCol = lastCol
		gridRow = lastRow
		setXYpos gridToX(gridCol), gridToY(gridRow)
		direction = int(rand(0, 3))
		straightSteps = 2
	}
}

onTouchStart "Player", sprite => {
	if isClone {
		damagePlayer
		gridCol = lastCol
		gridRow = lastRow
		setXYpos gridToX(gridCol), gridToY(gridRow)
		direction = chooseDirection()
		faceDirection
		shoot
	}
}

onTouchStart "PlayerBullet", sprite => {
	if isClone {
		takeHit
		sprite.die
	}
}

onTouchStart "Base", sprite => {
	if isClone {
		gridCol = lastCol
		gridRow = lastRow
		setXYpos gridToX(gridCol), gridToY(gridRow)
		direction = chooseDirection()
		faceDirection
		shoot
	}
}

onMsg "laser-fired", => {
	if isClone && gameRunning && inLaserLine() {
		takeHit
	}
}

onMsg (message, data) => {
	if message == "convoy-leader-down" && isClone && data == convoyId {
		refreshLeader
	}
}

onMsg "reset-game", => {
	if isClone {
		die
	} else {
		hide
	}
}
