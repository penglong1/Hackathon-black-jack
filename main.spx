const (
	gridCols = 20
	gridRows = 30
	cellSize = 12
	baseCol = 10
	baseRow = 29
)

var (
	gameRunning bool
	gameOverReason string
	score int
	wave int
	kills int
	enemyCount int
	maxEnemies int
	playerHP int
	baseHP int
	shieldHits int
	laserCharges int
	laserDirection int

	convoySize int
	convoy0NextSlot int
	convoy1NextSlot int
	convoy0LeaderSlot int
	convoy1LeaderSlot int
	enemySpawnConvoy int
	enemySpawnSlot int
	enemySpawnCol int
	enemySpawnRow int
	bulletSpawnCol int
	bulletSpawnRow int
	bulletSpawnDirection int
	itemSpawnCol int
	itemSpawnRow int
	itemSpawnType int
	obstacleSpawnCol int
	obstacleSpawnRow int
)

func gridToX(col int) float64 {
	return float64(-114 + col*cellSize)
}

func gridToY(row int) float64 {
	return float64(174 - row*cellSize)
}

func insideGrid(col, row int) bool {
	return col >= 0 && col < gridCols && row >= 0 && row < gridRows
}

func itemCellBlocked(col, row int) bool {
	return (row == 5 && (col == 4 || col == 5 || col == 14 || col == 15)) ||
		(row == 6 && (col == 7 || col == 8 || col == 11 || col == 12)) ||
		(row == 8 && (col == 7 || col == 12)) ||
		(row == 9 && (col == 5 || col == 6 || col == 13 || col == 14)) ||
		(row == 11 && (col == 9 || col == 10)) ||
		(row == 12 && (col == 6 || col == 7 || col == 12 || col == 13)) ||
		(row == 15 && (col == 3 || col == 4 || col == 15 || col == 16)) ||
		(row == 16 && (col == 8 || col == 11)) ||
		(row == 18 && (col == 5 || col == 14)) ||
		(row == 19 && (col == 8 || col == 11)) ||
		(row == 21 && (col == 9 || col == 10)) ||
		(row == 23 && (col == 6 || col == 13))
}

func spawnSteel(col, row int) {
	obstacleSpawnCol = col
	obstacleSpawnRow = row
	Steel.clone
}

func spawnCrate(col, row int) {
	obstacleSpawnCol = col
	obstacleSpawnRow = row
	Crate.clone
}

func buildMap() {
	spawnSteel 4, 5
	spawnSteel 5, 5
	spawnSteel 14, 5
	spawnSteel 15, 5
	spawnSteel 7, 8
	spawnSteel 12, 8
	spawnSteel 9, 11
	spawnSteel 10, 11
	spawnSteel 3, 15
	spawnSteel 4, 15
	spawnSteel 15, 15
	spawnSteel 16, 15
	spawnSteel 8, 19
	spawnSteel 11, 19
	spawnSteel 6, 23
	spawnSteel 13, 23

	spawnCrate 7, 6
	spawnCrate 8, 6
	spawnCrate 11, 6
	spawnCrate 12, 6
	spawnCrate 5, 9
	spawnCrate 6, 9
	spawnCrate 13, 9
	spawnCrate 14, 9
	spawnCrate 6, 12
	spawnCrate 7, 12
	spawnCrate 12, 12
	spawnCrate 13, 12
	spawnCrate 8, 16
	spawnCrate 11, 16
	spawnCrate 5, 18
	spawnCrate 14, 18
	spawnCrate 9, 21
	spawnCrate 10, 21
	spawnCrate 7, 25
	spawnCrate 12, 25
}

func resetGame() {
	gameRunning = false
	broadcastAndWait "reset-game"

	score = 0
	wave = 1
	kills = 0
	enemyCount = 0
	maxEnemies = 6
	playerHP = 3
	baseHP = 3
	convoySize = 6
	convoy0NextSlot = 0
	convoy1NextSlot = 0
	convoy0LeaderSlot = 0
	convoy1LeaderSlot = 0
	shieldHits = 0
	laserCharges = 0
	gameOverReason = ""

	buildMap
	gameRunning = true
	broadcast "game-ready"
}

func spawnEnemy() {
	if !gameRunning || enemyCount >= maxEnemies {
		return
	}
	if convoy0NextSlot >= convoySize {
		return
	}
	enemySpawnConvoy = 0
	enemySpawnSlot = convoy0NextSlot
	enemySpawnCol = 2
	enemySpawnRow = 0 - enemySpawnSlot
	convoy0NextSlot++
	enemyCount++
	Enemy.clone
}

func convoyLeaderDown(convoyId, slot int) {
	if convoyId == 0 {
		if convoy0LeaderSlot == slot {
			convoy0LeaderSlot++
		}
	} else {
		if convoy1LeaderSlot == slot {
			convoy1LeaderSlot++
		}
	}
	broadcast "convoy-leader-down", convoyId
}

func spawnPlayerShot(col, row, direction int) {
	if !gameRunning {
		return
	}
	bulletSpawnCol = col
	bulletSpawnRow = row
	bulletSpawnDirection = direction
	PlayerBullet.clone
}

func spawnEnemyShot(col, row, direction int) {
	if !gameRunning {
		return
	}
	bulletSpawnCol = col
	bulletSpawnRow = row
	bulletSpawnDirection = direction
	EnemyBullet.clone
}

func dropRandomItem() {
	if !gameRunning {
		return
	}
	itemSpawnCol = int(rand(2, 17))
	itemSpawnRow = int(rand(5, 24))
	for itemCellBlocked(itemSpawnCol, itemSpawnRow) {
		itemSpawnCol = int(rand(2, 17))
		itemSpawnRow = int(rand(5, 24))
	}
	itemSpawnType = int(rand(1, 3))
	Item.clone
}

func enemyDestroyed() {
	if !gameRunning {
		return
	}
	if enemyCount > 0 {
		enemyCount--
	}
	kills++
	score += 100

	nextWave := kills/6 + 1
	if nextWave > wave {
		wave = nextWave
		if maxEnemies < 8 {
			maxEnemies++
		}
		broadcast "new-wave"
	}
}

func damagePlayer() {
	if !gameRunning {
		return
	}
	if shieldHits > 0 {
		shieldHits--
		broadcast "shield-hit"
		return
	}
	playerHP--
	broadcast "player-damaged"
	if playerHP <= 0 {
		finishGame "我方战车已损毁"
	}
}

func damageBase() {
	if !gameRunning {
		return
	}
	baseHP--
	broadcast "base-damaged"
	if baseHP <= 0 {
		finishGame "基地已被攻破"
	}
}

func finishGame(reason string) {
	gameRunning = false
	gameOverReason = reason
	broadcast "game-over"
}

onStart => {
	resetGame
}

onStart => {
	wait 0.2
	spawnEnemy
	wait 0.35
	spawnEnemy
	wait 0.35
	spawnEnemy
	forever => {
		wait 0.7
		spawnEnemy
	}
}

onStart => {
	forever => {
		wait 30
		dropRandomItem
	}
}

onKey KeyEnter, => {
	if !gameRunning {
		resetGame
	}
}

onClick => {
	if !gameRunning {
		resetGame
	}
}

onMsg "game-over", => {
	println "游戏失败：" + gameOverReason
	println "得分：", score
	println "点击舞台或按 Enter 重新开始"
}
