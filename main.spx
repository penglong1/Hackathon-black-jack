const (
	gridCols = 20
	gridRows = 30
	cellSize = 12
	playerCol = 10
	playerRow = 27
)

var (
	gameRunning bool
	gameOverReason string
	score int
	wave int
	kills int
	enemyCount int
	maxEnemies int
	playerHP int
	shieldHits int
	laserCharges int
	laserDirection int
	stage int

	enemySpawnCol int
	enemySpawnRow int
	bulletSpawnCol int
	bulletSpawnRow int
	bulletSpawnDirection int
	itemSpawnCol int
	itemSpawnRow int
	itemSpawnType int
	obstacleSpawnCol int
	obstacleSpawnRow int
	enemySpawnLane int
)

func gridToX(col int) float64 {
	return float64(-114 + col*cellSize)
}

func gridToY(row int) float64 {
	return float64(174 - row*cellSize)
}

func insideGrid(col, row int) bool {
	return col >= 0 && col < gridCols && row >= 0 && row < gridRows
}

func itemCellBlocked(col, row int) bool {
	return (row == 5 && (col == 4 || col == 5 || col == 14 || col == 15)) ||
		(row == 6 && (col == 7 || col == 8 || col == 11 || col == 12)) ||
		(row == 8 && (col == 7 || col == 12)) ||
		(row == 9 && (col == 5 || col == 6 || col == 13 || col == 14)) ||
		(row == 11 && (col == 9 || col == 10)) ||
		(row == 12 && (col == 6 || col == 7 || col == 12 || col == 13)) ||
		(row == 15 && (col == 3 || col == 4 || col == 15 || col == 16)) ||
		(row == 16 && (col == 8 || col == 11)) ||
		(row == 18 && (col == 5 || col == 14)) ||
		(row == 19 && (col == 8 || col == 11)) ||
		(row == 21 && (col == 9 || col == 10)) ||
		(row == 23 && (col == 6 || col == 13))
}

func spawnSteel(col, row int) {
	obstacleSpawnCol = col
	obstacleSpawnRow = row
	Steel.clone
}

func spawnCrate(col, row int) {
	obstacleSpawnCol = col
	obstacleSpawnRow = row
	Crate.clone
}

func buildMap() {
	spawnSteel 4, 5
	spawnSteel 5, 5
	spawnSteel 14, 5
	spawnSteel 15, 5
	spawnSteel 7, 8
	spawnSteel 12, 8
	spawnSteel 9, 11
	spawnSteel 10, 11
	spawnSteel 3, 15
	spawnSteel 4, 15
	spawnSteel 15, 15
	spawnSteel 16, 15
	spawnSteel 8, 19
	spawnSteel 11, 19
	spawnSteel 6, 23
	spawnSteel 13, 23

	spawnCrate 7, 6
	spawnCrate 8, 6
	spawnCrate 11, 6
	spawnCrate 12, 6
	spawnCrate 5, 9
	spawnCrate 6, 9
	spawnCrate 13, 9
	spawnCrate 14, 9
	spawnCrate 6, 12
	spawnCrate 7, 12
	spawnCrate 12, 12
	spawnCrate 13, 12
	spawnCrate 8, 16
	spawnCrate 11, 16
	spawnCrate 5, 18
	spawnCrate 14, 18
	spawnCrate 9, 21
	spawnCrate 10, 21
	spawnCrate 7, 25
	spawnCrate 12, 25
}

func resetGame() {
	gameRunning = false
	broadcastAndWait "reset-game"

	score = 0
	wave = 1
	stage = 1
	kills = 0
	enemyCount = 0
	maxEnemies = 6
	playerHP = 100
	shieldHits = 0
	laserCharges = 0
	gameOverReason = ""

	buildMap
	gameRunning = true
	broadcast "game-ready"
}

func spawnEnemy() {
	if !gameRunning || enemyCount >= maxEnemies {
		return
	}
	if stage == 1 {
		enemySpawnLane = 0
	} else {
		enemySpawnLane = int(rand(0, 1))
	}
	enemySpawnCol = 2 + enemySpawnLane*15
	enemySpawnRow = 0
	enemyCount++
	Enemy.clone
}

func spawnPlayerShot(col, row, direction int) {
	if !gameRunning {
		return
	}
	bulletSpawnCol = col
	bulletSpawnRow = row
	bulletSpawnDirection = direction
	PlayerBullet.clone
}

func spawnEnemyShot(col, row, direction int) {
	if !gameRunning {
		return
	}
	bulletSpawnCol = col
	bulletSpawnRow = row
	bulletSpawnDirection = direction
	EnemyBullet.clone
}

func dropRandomItem() {
	if !gameRunning {
		return
	}
	itemSpawnCol = int(rand(2, 17))
	itemSpawnRow = int(rand(5, 24))
	for itemCellBlocked(itemSpawnCol, itemSpawnRow) {
		itemSpawnCol = int(rand(2, 17))
		itemSpawnRow = int(rand(5, 24))
	}
	itemSpawnType = int(rand(1, 3))
	Item.clone
}

func enemyDestroyed() {
	if !gameRunning {
		return
	}
	if enemyCount > 0 {
		enemyCount--
	}
	kills++
	score += 100

	nextWave := kills/6 + 1
	if nextWave > wave {
		wave = nextWave
		if maxEnemies < 8 {
			maxEnemies++
		}
		broadcast "new-wave"
	}
}

func damagePlayer() {
	if !gameRunning {
		return
	}
	if shieldHits > 0 {
		shieldHits--
		broadcast "shield-hit"
		return
	}
	playerHP--
	broadcast "player-damaged"
	if playerHP <= 0 {
		finishGame "我方战车已损毁"
	}
}

func finishGame(reason string) {
	gameRunning = false
	gameOverReason = reason
	broadcast "game-over"
}

onStart => {
	resetGame
}

onStart => {
	forever => {
		wait 2
		spawnEnemy
	}
}

onStart => {
	forever => {
		wait 30
		dropRandomItem
	}
}

onKey KeyEnter, => {
	if !gameRunning {
		resetGame
	}
}

onClick => {
	if !gameRunning {
		resetGame
	}
}

onMsg "game-over", => {
	println "游戏失败：" + gameOverReason
	println "得分：", score
	println "主战坦克生命值：", playerHP
	println "点击舞台或按 Enter 重新开始"
}
