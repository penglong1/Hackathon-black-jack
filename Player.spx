var (
	gridCol int
	gridRow int
	direction int
	lastCol int
	lastRow int
	lastAttackAt float64
)

const attackCooldown = 0.4

func faceDirection() {
	if direction == 0 {
		turnTo Up
	} else if direction == 1 {
		turnTo Right
	} else if direction == 2 {
		turnTo Down
	} else {
		turnTo Left
	}
}

func resetPlayer() {
	gridCol = playerCol
	gridRow = playerRow
	direction = 0
	lastCol = gridCol
	lastRow = gridRow
	lastAttackAt = timer - attackCooldown
	faceDirection
	setXYpos gridToX(gridCol), gridToY(gridRow)
	show
}

func aimLeft() {
	if !gameRunning {
		return
	}
	direction--
	if direction < 0 {
		direction = 3
	}
	faceDirection
}

func aimRight() {
	if !gameRunning {
		return
	}
	direction++
	if direction > 3 {
		direction = 0
	}
	faceDirection
}

func attack() {
	if !gameRunning {
		return
	}
	if timer-lastAttackAt < attackCooldown {
		return
	}
	lastAttackAt = timer
	if laserCharges > 0 {
		laserCharges--
		laserDirection = direction
		broadcast "laser-fired"
		return
	}
	spawnPlayerShot gridCol, gridRow, direction
}

onStart => {
	resetPlayer
}

onStart => {
	forever => {
		wait attackCooldown
		attack
	}
}

onKey KeyLeft, => {
	aimLeft
}

onKey KeyRight, => {
	aimRight
}

onKey KeyUp, => {
	attack
}

onKey KeyDown, => {
	attack
}

onKey KeyX, => {
	attack
}

onTouchStart "Enemy", sprite => {
	damagePlayer
}

onMsg "reset-game", => {
	resetPlayer
}

onMsg "shield-hit", => {
	say "护盾抵挡！", 0.5
}

onMsg "player-damaged", => {
	say "主战坦克受击！生命：" + playerHP, 0.5
}

onMsg "game-over", => {
	say gameOverReason + "，点击舞台重新开始"
}
